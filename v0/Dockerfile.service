FROM ghcr.io/astral-sh/uv:0.12.3@sha256:2d890623d310b57771ce840f0da5eed5fc6d657da05ffaa45d82797b53fa3abc AS uv
FROM docker:29-cli@sha256:4e60c31615e83523afbb59773b25d055c0da9edcd5f80a4c6a6eebad49de1a25 AS docker-cli
FROM python:3.12-slim-bookworm@sha256:44cf1793efa7c7a476bb0f2cff81443f4a072c90c1cb127e2924933daa3e8c64 AS python-base

FROM python-base AS wheel
COPY --from=uv /uv /usr/local/bin/uv
ENV UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never
COPY --from=release requirements*.txt /opt/release/
RUN uv venv /opt/lasa/.venv

FROM wheel AS build
RUN uv pip sync --python /opt/lasa/.venv/bin/python --require-hashes /opt/release/requirements.txt
COPY --from=release lasa_service-*.whl /opt/release/
RUN uv pip install --python /opt/lasa/.venv/bin/python --no-deps /opt/release/lasa_service-*.whl

FROM wheel AS build-portal
RUN uv pip sync --python /opt/lasa/.venv/bin/python --require-hashes /opt/release/requirements-portal.txt
COPY --from=release lasa_service-*.whl /opt/release/
RUN uv pip install --python /opt/lasa/.venv/bin/python --no-deps /opt/release/lasa_service-*.whl

FROM python-base AS runtime
ENV PATH="/opt/lasa/.venv/bin:$PATH" PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
USER 10001:10001

FROM runtime AS portal
COPY --from=build-portal /opt/lasa/.venv /opt/lasa/.venv
EXPOSE 8080
ENTRYPOINT ["python", "-m", "portal"]
CMD ["--config", "/etc/lasa-portal/config.json"]

FROM runtime AS service-base
COPY --from=build /opt/lasa/.venv /opt/lasa/.venv

FROM service-base AS launcher
COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
ENTRYPOINT ["lasa-launcher"]

FROM service-base AS supervisor
ENTRYPOINT ["lasa"]
CMD ["--config", "/etc/lasa/config.json"]
