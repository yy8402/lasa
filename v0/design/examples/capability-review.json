{
  "definition_format": "lasa-capability/1.0.0",
  "id": "https://contracts.example.net/capabilities/design.review",
  "version": "1.0.0",
  "title": "Review supplied design against explicit criteria",
  "outcome": "Return criterion coverage and actionable findings grounded in the supplied design.",
  "non_guarantees": [
    "Does not prove correctness or inspect resources not supplied in the request."
  ],
  "input_schema": {
    "type": "object",
    "properties": {
      "design": {
        "type": "string",
        "minLength": 1,
        "maxLength": 32000
      },
      "criteria": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            }
          },
          "required": [
            "id",
            "description"
          ],
          "additionalProperties": false
        },
        "minItems": 1,
        "maxItems": 32
      }
    },
    "required": [
      "design",
      "criteria"
    ],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "findings": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "criterion_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "severity": {
              "enum": [
                "info",
                "warning",
                "error"
              ]
            },
            "observation": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "recommendation": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          },
          "required": [
            "criterion_id",
            "severity",
            "observation",
            "recommendation"
          ],
          "additionalProperties": false
        },
        "maxItems": 128
      },
      "coverage": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "criterion_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "disposition": {
              "enum": [
                "reviewed",
                "insufficient_input"
              ]
            },
            "evidence": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          },
          "required": [
            "criterion_id",
            "disposition",
            "evidence"
          ],
          "additionalProperties": false
        },
        "minItems": 1,
        "maxItems": 32
      }
    },
    "required": [
      "findings",
      "coverage"
    ],
    "additionalProperties": false
  },
  "preconditions": [
    {
      "kind": "input_schema",
      "description": "Design text and criteria must be supplied."
    },
    {
      "kind": "budget_minimum",
      "description": "A bounded semantic assessment is required.",
      "resource": "model_calls",
      "minimum": 1
    }
  ],
  "max_effects": [
    "workspace.read"
  ],
  "postconditions": [
    {
      "id": "criterion-coverage",
      "criterion": "Every supplied criterion has a coverage entry; findings cite supplied design evidence.",
      "method": "semantic_review",
      "evidence_required": [
        "coverage and supporting observations"
      ]
    }
  ],
  "failures": [
    {
      "code": "insufficient_input",
      "meaning": "The supplied design does not contain enough information to review the requested criteria.",
      "retry": "readmission",
      "effect_disposition": "known"
    },
    {
      "code": "evaluation_failed",
      "meaning": "The bounded review could not be completed.",
      "retry": "readmission",
      "effect_disposition": "known"
    }
  ],
  "effect_safety": {
    "external_write_commit_evidence_required": false,
    "unknown_commit_possible": false,
    "retry_rule": "readmit_if_no_uncertain_effect"
  }
}
