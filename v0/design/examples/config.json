{
  "config_version": "1.0.0",
  "service": {
    "id": "https://identity.example.net/services/layer1",
    "deployment_revision": "deploy-target-example",
    "base_url": "https://layer1.example.net/lasa/v1",
    "publish_api_catalog": true,
    "session_retention_seconds": 604800
  },
  "authentication": {
    "issuer": "https://identity.example.net",
    "jwks_url": "https://identity.example.net/.well-known/jwks.json",
    "allowed_algorithms": [
      "ES256"
    ]
  },
  "authorization": {
    "policy_file": "authorization.json"
  },
  "executors": [
    {
      "id": "executor-codex-main",
      "model": "gpt-5.5",
      "provider_base_url": "https://api.openai.com/v1/",
      "credential_ref": "env:OPENAI_API_KEY"
    }
  ],
  "bindings": [
    {
      "binding_id": "binding-review-local",
      "contract": {
        "id": "https://contracts.example.net/capabilities/design.review",
        "version": "1.0.0",
        "digest": "sha256:269986e0e622b8b4d7c7528a5e4f66c5e0413e6a452fd762e8a9aafcab99a27c"
      },
      "executor_id": "executor-codex-main",
      "approved_resources": [
        {
          "resource": "workspace:self",
          "actions": [
            "read"
          ]
        }
      ],
      "allowed_effects": [
        "workspace.read"
      ],
      "required_operations": []
    },
    {
      "binding_id": "binding-attempt-local",
      "contract": {
        "id": "https://contracts.example.net/capabilities/task.attempt",
        "version": "1.0.0",
        "digest": "sha256:ab18f43c25384940b0d00e9cbd09c0ae6bd42d2b361f6baffcdfeffafa4790e9"
      },
      "executor_id": "executor-codex-main",
      "approved_resources": [
        {
          "resource": "workspace:self",
          "actions": [
            "read",
            "create",
            "update"
          ]
        }
      ],
      "allowed_effects": [
        "workspace.read",
        "workspace.write"
      ],
      "required_operations": []
    }
  ],
  "published_contracts": [
    {
      "id": "https://contracts.example.net/capabilities/design.review",
      "version": "1.0.0",
      "digest": "sha256:269986e0e622b8b4d7c7528a5e4f66c5e0413e6a452fd762e8a9aafcab99a27c"
    },
    {
      "id": "https://contracts.example.net/capabilities/task.attempt",
      "version": "1.0.0",
      "digest": "sha256:ab18f43c25384940b0d00e9cbd09c0ae6bd42d2b361f6baffcdfeffafa4790e9"
    }
  ],
  "limits": {
    "content_recovery": {
      "max_inspection_retries_per_transfer": 1,
      "max_candidate_revisions_per_transfer": 1,
      "max_actions_per_task": 4
    },
    "max_task_budget": {
      "model_tokens": 96000,
      "model_calls": 12,
      "tool_calls": 12,
      "delegations": 2,
      "wall_time_ms": 180000,
      "input_bytes": 64000,
      "output_bytes": 32000,
      "artifact_bytes": 128000
    },
    "assessment_budget": {
      "model_tokens": 24000,
      "model_calls": 2,
      "tool_calls": 0,
      "delegations": 0,
      "wall_time_ms": 30000,
      "input_bytes": 64000,
      "output_bytes": 4000,
      "artifact_bytes": 0
    },
    "integration_reserve": {
      "model_tokens": 16000,
      "model_calls": 3,
      "tool_calls": 0,
      "delegations": 0,
      "wall_time_ms": 20000,
      "input_bytes": 0,
      "output_bytes": 4000,
      "artifact_bytes": 0
    },
    "max_children": 2,
    "min_verification_margin_ms": 1000,
    "max_derived_descendants": 64,
    "max_plan_steps": 16,
    "max_active_tasks": 4,
    "max_clock_skew_seconds": 5,
    "reconciliation_timeout_seconds": 30
  },
  "routing": {
    "preferred_executor": "peer"
  },
  "discovery_cache": {
    "descriptor_max_age_seconds": 300,
    "catalog_max_age_seconds": 60,
    "availability_max_age_seconds": 5,
    "page_size": 50
  },
  "storage": {
    "state_root": "/var/lib/lasa/parent",
    "listen_host": "127.0.0.1",
    "listen_port": 8787
  },
  "peers": [
    {
      "descriptor_url": "https://layer2.example.net/lasa/v1/descriptor",
      "expected_service_id": "https://identity.example.net/services/layer2",
      "allowed_base_url": "https://layer2.example.net/lasa/v1",
      "credential_ref": "file:/run/secrets/lasa-layer2-token",
      "request_timeout_seconds": 15,
      "execution_key_ref": "env:LASA_EXECUTION_KEY"
    }
  ],
  "runtime": {
    "launcher_socket": "/run/lasa/launcher.sock"
  }
}
