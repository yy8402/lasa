{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.net/lasa/1.0.0/private.schema.json",
  "$defs": {
    "Prompts": {
      "type": "object",
      "$defs": {
        "text": {
          "type": "string",
          "pattern": "\\S"
        }
      },
      "properties": {
        "assessment_developer": {
          "$ref": "#/$defs/Prompts/$defs/text",
          "pattern": "\\{purpose\\}"
        },
        "plan_proposal": {
          "$ref": "#/$defs/Prompts/$defs/text"
        },
        "plan_verification": {
          "$ref": "#/$defs/Prompts/$defs/text"
        },
        "outcome_verification": {
          "$ref": "#/$defs/Prompts/$defs/text"
        },
        "execution_developer": {
          "$ref": "#/$defs/Prompts/$defs/text"
        },
        "source_execution": {
          "$ref": "#/$defs/Prompts/$defs/text"
        },
        "integration": {
          "$ref": "#/$defs/Prompts/$defs/text"
        },
        "fallback_conversion": {
          "$ref": "#/$defs/Prompts/$defs/text"
        }
      },
      "required": [
        "assessment_developer",
        "plan_proposal",
        "plan_verification",
        "outcome_verification",
        "execution_developer",
        "source_execution",
        "integration",
        "fallback_conversion"
      ],
      "additionalProperties": false
    },
    "AuthorizationPolicy": {
      "type": "object",
      "properties": {
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "principals": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "subject": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "user",
                  "peer"
                ]
              },
              "rules": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "authorization_ref": {
                      "type": "string",
                      "minLength": 1
                    },
                    "contracts": {
                      "type": "array",
                      "items": {
                        "$ref": "contracts.schema.json#/$defs/CapabilityRef"
                      },
                      "uniqueItems": true
                    },
                    "resources": {
                      "type": "array",
                      "items": {
                        "$ref": "contracts.schema.json#/$defs/ResourceRule"
                      },
                      "uniqueItems": true
                    },
                    "effects": {
                      "type": "array",
                      "items": {
                        "enum": [
                          "workspace.read",
                          "workspace.write",
                          "external.read",
                          "external.write"
                        ]
                      },
                      "uniqueItems": true
                    },
                    "budget": {
                      "$ref": "contracts.schema.json#/$defs/Budget"
                    },
                    "max_hops": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 32
                    },
                    "content_diagnostics": {
                      "type": "boolean"
                    },
                    "offer_preconditions": {
                      "type": "array",
                      "items": {
                        "$ref": "contracts.schema.json#/$defs/Precondition"
                      }
                    },
                    "delegation_grants": {
                      "type": "array",
                      "uniqueItems": true,
                      "items": {
                        "$ref": "contracts.schema.json#/$defs/DelegationGrant"
                      }
                    },
                    "verifier_trust": {
                      "type": "array",
                      "items": {
                        "$ref": "contracts.schema.json#/$defs/VerifierTrust"
                      },
                      "uniqueItems": true,
                      "maxItems": 32
                    }
                  },
                  "required": [
                    "authorization_ref",
                    "contracts",
                    "resources",
                    "effects",
                    "budget",
                    "max_hops",
                    "content_diagnostics",
                    "delegation_grants"
                  ],
                  "additionalProperties": false
                },
                "uniqueItems": true
              },
              "service_id": {
                "type": "string",
                "pattern": "^https://"
              }
            },
            "required": [
              "subject",
              "kind",
              "rules"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "peer"
                    }
                  }
                },
                "then": {
                  "required": [
                    "service_id"
                  ]
                }
              }
            ]
          },
          "uniqueItems": true
        },
        "trusted_delegator_service_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://",
            "maxLength": 2048
          },
          "uniqueItems": true
        }
      },
      "required": [
        "revision",
        "principals",
        "trusted_delegator_service_ids"
      ],
      "additionalProperties": false
    },
    "McpOperation": {
      "type": "object",
      "properties": {
        "operation_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "effect": {
          "const": "external.read"
        },
        "resource": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "input_schema": {
          "type": "object"
        },
        "argument_constraints": {
          "type": "object"
        },
        "output_schema": {
          "type": "object"
        },
        "upstream_tool": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "upstream_output_schema": {
          "type": [
            "object",
            "null"
          ]
        },
        "result_format": {
          "enum": [
            "structured",
            "text"
          ]
        },
        "task_input_bindings": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "properties": {
              "input_field": {
                "type": "string",
                "minLength": 1
              },
              "argument_field": {
                "type": "string",
                "minLength": 1
              },
              "comparison": {
                "enum": [
                  "exact",
                  "basename"
                ]
              }
            },
            "required": [
              "input_field",
              "argument_field",
              "comparison"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "operation_id",
        "description",
        "effect",
        "resource",
        "input_schema",
        "argument_constraints",
        "output_schema",
        "upstream_tool",
        "upstream_output_schema",
        "result_format",
        "task_input_bindings"
      ],
      "additionalProperties": false
    },
    "JsonGetOperation": {
      "type": "object",
      "properties": {
        "operation_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "effect": {
          "const": "external.read"
        },
        "resource": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "input_schema": {
          "type": "object"
        },
        "argument_constraints": {
          "type": "object"
        },
        "output_schema": {
          "type": "object"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "response_schema": {
          "type": "object"
        },
        "result_fields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true
        },
        "probe_arguments": {
          "type": "object"
        },
        "task_input_bindings": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "properties": {
              "input_field": {
                "type": "string",
                "minLength": 1
              },
              "argument_field": {
                "type": "string",
                "minLength": 1
              },
              "comparison": {
                "enum": [
                  "exact",
                  "basename"
                ]
              }
            },
            "required": [
              "input_field",
              "argument_field",
              "comparison"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "operation_id",
        "description",
        "effect",
        "resource",
        "input_schema",
        "argument_constraints",
        "output_schema",
        "url",
        "response_schema",
        "result_fields",
        "probe_arguments",
        "task_input_bindings"
      ],
      "additionalProperties": false
    },
    "ConnectorLimits": {
      "type": "object",
      "properties": {
        "max_queue": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "request_timeout_seconds": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 120
        },
        "response_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 1048576
        },
        "recovery_interval_seconds": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 3600
        },
        "schema_refresh_seconds": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 3600
        }
      },
      "required": [
        "max_queue",
        "request_timeout_seconds",
        "response_bytes",
        "recovery_interval_seconds",
        "schema_refresh_seconds"
      ],
      "additionalProperties": false
    },
    "FulfillmentBinding": {
      "type": "object",
      "properties": {
        "binding_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
        },
        "contract": {
          "$ref": "https://schemas.example.net/lasa/1.0.0/contracts.schema.json#/$defs/CapabilityRef"
        },
        "executor_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
        },
        "approved_resources": {
          "type": "array",
          "items": {
            "$ref": "https://schemas.example.net/lasa/1.0.0/contracts.schema.json#/$defs/ResourceRule"
          }
        },
        "allowed_effects": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "workspace.read",
              "workspace.write",
              "external.read",
              "external.write"
            ]
          },
          "uniqueItems": true
        },
        "required_operations": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
          },
          "uniqueItems": true,
          "maxItems": 128
        }
      },
      "required": [
        "binding_id",
        "contract",
        "executor_id",
        "approved_resources",
        "allowed_effects",
        "required_operations"
      ],
      "additionalProperties": false
    },
    "Connectors": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
              },
              "limits": {
                "$ref": "#/$defs/ConnectorLimits"
              },
              "operations": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/McpOperation"
                },
                "minItems": 1,
                "maxItems": 128
              },
              "kind": {
                "const": "mcp-stdio"
              },
              "command": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "secret_env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048
                }
              }
            },
            "required": [
              "id",
              "limits",
              "operations",
              "kind",
              "command",
              "args",
              "secret_env"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
              },
              "limits": {
                "$ref": "#/$defs/ConnectorLimits"
              },
              "operations": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/McpOperation"
                },
                "minItems": 1,
                "maxItems": 128
              },
              "kind": {
                "const": "mcp-http"
              },
              "url": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://"
              },
              "credential_ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "ca_file": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              }
            },
            "required": [
              "id",
              "limits",
              "operations",
              "kind",
              "url"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
              },
              "limits": {
                "$ref": "#/$defs/ConnectorLimits"
              },
              "operations": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/JsonGetOperation"
                },
                "minItems": 1,
                "maxItems": 128
              },
              "kind": {
                "const": "json-get"
              },
              "base_url": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://"
              },
              "headers": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "credential_ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "ca_file": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              }
            },
            "required": [
              "id",
              "limits",
              "operations",
              "kind",
              "base_url",
              "headers"
            ],
            "additionalProperties": false
          }
        ]
      },
      "maxItems": 32
    },
    "StaticTokenRegistry": {
      "type": "object",
      "properties": {
        "tokens": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "properties": {
              "subject": {
                "type": "string",
                "minLength": 1
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "expires_at": {
                "type": "integer",
                "minimum": 1,
                "maximum": 253402300799
              }
            },
            "required": [
              "subject",
              "digest",
              "expires_at"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "tokens"
      ],
      "additionalProperties": false
    }
  }
}
