{
  "type": "object",
  "properties": {
    "config_version": {
      "const": "1.0.0"
    },
    "prompts_file": {
      "description": "Optional absolute path to the administrator's complete prompt file.",
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "service": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "maxLength": 2048
        },
        "deployment_revision": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
        },
        "base_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "maxLength": 2048
        },
        "publish_api_catalog": {
          "type": "boolean"
        },
        "session_retention_seconds": {
          "type": "integer",
          "minimum": 3600,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "id",
        "base_url"
      ],
      "additionalProperties": false
    },
    "authentication": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "jwt",
              "default": "jwt"
            },
            "issuer": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://",
              "maxLength": 2048
            },
            "jwks_url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://",
              "maxLength": 2048
            },
            "allowed_algorithms": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "ES256",
                  "EdDSA",
                  "RS256"
                ]
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "jwks_file": {
              "type": "string",
              "minLength": 1,
              "description": "Public issuer keys. Relative paths resolve beside config.json."
            }
          },
          "required": [
            "issuer",
            "allowed_algorithms"
          ],
          "additionalProperties": false,
          "oneOf": [
            {
              "required": [
                "jwks_url"
              ],
              "not": {
                "required": [
                  "jwks_file"
                ]
              }
            },
            {
              "required": [
                "jwks_file"
              ],
              "not": {
                "required": [
                  "jwks_url"
                ]
              }
            }
          ]
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "static_token"
            },
            "tokens_file": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "description": "Standalone credential registry. Relative paths resolve beside config.json."
            }
          },
          "required": [
            "mode"
          ],
          "additionalProperties": false
        }
      ]
    },
    "authorization": {
      "type": "object",
      "properties": {
        "policy_file": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "description": "Receiver-owned policy. Relative paths resolve beside config.json."
        }
      },
      "additionalProperties": false
    },
    "contract_publishers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "namespace": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://",
            "maxLength": 2048
          },
          "trusted_registry_file": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "required": [
          "namespace",
          "trusted_registry_file"
        ],
        "additionalProperties": false
      }
    },
    "executors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
          },
          "model": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "provider_base_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://",
            "maxLength": 2048
          },
          "provider_ca_file": {
            "type": "string",
            "minLength": 1
          },
          "credential_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "connectors": {
            "$ref": "private.schema.json#/$defs/Connectors"
          }
        },
        "required": [
          "id",
          "model",
          "provider_base_url",
          "credential_ref"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "bindings": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.example.net/lasa/1.0.0/private.schema.json#/$defs/FulfillmentBinding"
      }
    },
    "published_contracts": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "enum": [
              "design.review",
              "task.attempt",
              "documents.read",
              "documents.search",
              "repository.inspect",
              "design.review-checklist"
            ]
          },
          {
            "$ref": "contracts.schema.json#/$defs/CapabilityRef"
          }
        ]
      },
      "uniqueItems": true
    },
    "limits": {
      "type": "object",
      "properties": {
        "max_task_budget": {
          "$ref": "contracts.schema.json#/$defs/Budget"
        },
        "assessment_budget": {
          "$ref": "contracts.schema.json#/$defs/Budget"
        },
        "integration_reserve": {
          "$ref": "contracts.schema.json#/$defs/Budget"
        },
        "max_hops": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32
        },
        "max_children": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "max_plan_steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "max_active_tasks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "max_clock_skew_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60
        },
        "reconciliation_timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "routing": {
      "type": "object",
      "properties": {
        "preferred_executor": {
          "enum": [
            "local",
            "peer"
          ]
        },
        "unclaimed_peer_fallback": {
          "enum": [
            "reject",
            "attempt"
          ]
        }
      },
      "additionalProperties": false
    },
    "discovery_cache": {
      "type": "object",
      "properties": {
        "descriptor_max_age_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600
        },
        "catalog_max_age_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 300
        },
        "availability_max_age_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30
        },
        "page_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "storage": {
      "type": "object",
      "properties": {
        "state_root": {
          "type": "string",
          "minLength": 1,
          "description": "Absolute service state directory containing private/ and workspaces/."
        },
        "listen_host": {
          "enum": [
            "127.0.0.1",
            "0.0.0.0"
          ]
        },
        "listen_port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "tls": {
          "type": "object",
          "properties": {
            "certificate_file": {
              "type": "string",
              "minLength": 1
            },
            "key_file": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "certificate_file",
            "key_file"
          ],
          "additionalProperties": false
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "verifiers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "contract": {
            "$ref": "contracts.schema.json#/$defs/CapabilityRef"
          },
          "verifier_id": {
            "enum": [
              "design-review-v1",
              "task-attempt-v1",
              "documents-read-v1",
              "documents-search-v1",
              "repository-inspect-v1"
            ]
          }
        },
        "required": [
          "contract",
          "verifier_id"
        ],
        "additionalProperties": false
      },
      "uniqueItems": true
    },
    "peers": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "properties": {
          "descriptor_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://",
            "maxLength": 2048
          },
          "expected_service_id": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://",
            "maxLength": 2048
          },
          "allowed_base_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://",
            "maxLength": 2048
          },
          "credential_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "authentication": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "mode": {
                    "const": "jwt"
                  }
                },
                "required": [
                  "mode"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "mode": {
                    "const": "static_token"
                  },
                  "subject": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "mode",
                  "subject"
                ],
                "additionalProperties": false
              }
            ]
          },
          "authorization_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "request_timeout_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 60
          },
          "ca_file": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "descriptor_url",
          "expected_service_id",
          "allowed_base_url",
          "credential_ref",
          "authorization_ref"
        ],
        "additionalProperties": false
      }
    },
    "default_executor": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
    },
    "runtime": {
      "type": "object",
      "properties": {
        "launcher_socket": {
          "type": "string",
          "pattern": "^/[^\\u0000]+$",
          "maxLength": 103
        },
        "startup_timeout_ms": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 60000
        }
      },
      "required": [
        "launcher_socket"
      ],
      "additionalProperties": false
    },
    "verification": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "reasoning_effort": {
          "enum": [
            "none",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ]
        }
      },
      "required": [
        "model"
      ],
      "additionalProperties": false
    },
    "content_security": {
      "$ref": "private.schema.json#/$defs/ContentSecurity"
    }
  },
  "required": [
    "config_version",
    "service",
    "authentication",
    "executors",
    "runtime"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.net/lasa/1.0.0/config.schema.json",
  "title": "LASA service deployment manifest",
  "allOf": [
    {
      "if": {
        "properties": {
          "executors": {
            "minItems": 2
          }
        }
      },
      "then": {
        "required": [
          "default_executor"
        ]
      }
    }
  ]
}
