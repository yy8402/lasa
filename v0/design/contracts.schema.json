{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.net/lasa/1.0.0/contracts.schema.json",
  "title": "LASA 1.0.0 contracts",
  "description": "Design only. Public wire contracts and explicitly private internal snapshots share definitions, not authority.",
  "not": {},
  "$defs": {
    "CapabilityRef": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "maxLength": 2048
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "version",
        "digest"
      ],
      "additionalProperties": false
    },
    "ResourceRule": {
      "type": "object",
      "properties": {
        "resource": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "read",
              "create",
              "update",
              "delete",
              "execute"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "resource",
        "actions"
      ],
      "additionalProperties": false
    },
    "VerificationCriterion": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
        },
        "criterion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "method": {
          "type": "string",
          "enum": [
            "schema",
            "artifact_digest",
            "semantic_review",
            "test"
          ]
        },
        "evidence_required": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "criterion",
        "method",
        "evidence_required"
      ],
      "additionalProperties": false
    },
    "Precondition": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "input_schema"
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            }
          },
          "required": [
            "kind",
            "description"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "resource_authorized"
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            "resource": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "actions": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "read",
                  "create",
                  "update",
                  "delete",
                  "execute"
                ]
              },
              "minItems": 1,
              "uniqueItems": true
            }
          },
          "required": [
            "kind",
            "description",
            "resource",
            "actions"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "artifact_present"
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            "input_field": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "media_type": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "required": [
            "kind",
            "description",
            "input_field",
            "media_type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "budget_minimum"
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            "resource": {
              "type": "string",
              "enum": [
                "model_tokens",
                "model_calls",
                "tool_calls",
                "delegations",
                "wall_time_ms",
                "input_bytes",
                "output_bytes",
                "artifact_bytes"
              ]
            },
            "minimum": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "kind",
            "description",
            "resource",
            "minimum"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "semantic_review"
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            "criterion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            "evidence_required": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "minItems": 1,
              "uniqueItems": true
            }
          },
          "required": [
            "kind",
            "description",
            "criterion",
            "evidence_required"
          ],
          "additionalProperties": false
        }
      ]
    },
    "CapabilityFailure": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
        },
        "meaning": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "retry": {
          "type": "string",
          "enum": [
            "never",
            "readmission",
            "reconcile"
          ]
        },
        "effect_disposition": {
          "type": "string",
          "enum": [
            "known",
            "unknown_possible"
          ]
        }
      },
      "required": [
        "code",
        "meaning",
        "retry",
        "effect_disposition"
      ],
      "additionalProperties": false
    },
    "CapabilityDefinition": {
      "type": "object",
      "properties": {
        "definition_format": {
          "const": "lasa-capability/1.0.0"
        },
        "id": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "maxLength": 2048
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "outcome": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "non_guarantees": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "minItems": 1
        },
        "input_schema": {
          "type": [
            "object",
            "boolean"
          ]
        },
        "output_schema": {
          "type": [
            "object",
            "boolean"
          ]
        },
        "preconditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Precondition"
          }
        },
        "max_effects": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "workspace.read",
              "workspace.write",
              "external.read",
              "external.write"
            ]
          },
          "uniqueItems": true
        },
        "postconditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/VerificationCriterion"
          },
          "minItems": 1
        },
        "failures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CapabilityFailure"
          },
          "minItems": 1
        },
        "effect_safety": {
          "type": "object",
          "properties": {
            "external_write_commit_evidence_required": {
              "type": "boolean"
            },
            "unknown_commit_possible": {
              "type": "boolean"
            },
            "retry_rule": {
              "type": "string",
              "enum": [
                "readmit_if_no_uncertain_effect",
                "reconcile_before_retry"
              ]
            }
          },
          "required": [
            "external_write_commit_evidence_required",
            "unknown_commit_possible",
            "retry_rule"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "definition_format",
        "id",
        "version",
        "title",
        "outcome",
        "non_guarantees",
        "input_schema",
        "output_schema",
        "preconditions",
        "max_effects",
        "postconditions",
        "failures",
        "effect_safety"
      ],
      "additionalProperties": false
    },
    "CapabilityOffer": {
      "type": "object",
      "properties": {
        "offer_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
        },
        "catalog_view": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
        },
        "contract": {
          "$ref": "#/$defs/CapabilityRef"
        },
        "restrictions": {
          "type": "object",
          "properties": {
            "allowed_effects": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "workspace.read",
                  "workspace.write",
                  "external.read",
                  "external.write"
                ]
              },
              "uniqueItems": true
            },
            "additional_preconditions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "budget_minimum"
                  },
                  "description": {
                    "const": "Minimum execution budget for this offer."
                  },
                  "resource": {
                    "enum": [
                      "model_tokens",
                      "model_calls",
                      "tool_calls",
                      "wall_time_ms",
                      "input_bytes",
                      "output_bytes",
                      "artifact_bytes"
                    ]
                  },
                  "minimum": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "kind",
                  "description",
                  "resource",
                  "minimum"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "allowed_effects",
            "additional_preconditions"
          ],
          "additionalProperties": false
        },
        "max_budget": {
          "$ref": "#/$defs/ConsumerBudget"
        },
        "valid_until": {
          "type": "string",
          "format": "date-time"
        },
        "processing": {
          "$ref": "#/$defs/ProcessingTerms"
        },
        "execution_commitment": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "offer_id",
        "revision",
        "catalog_view",
        "contract",
        "restrictions",
        "max_budget",
        "valid_until",
        "processing"
      ],
      "additionalProperties": false
    },
    "OfferCatalog": {
      "type": "object",
      "properties": {
        "service_id": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "maxLength": 2048
        },
        "catalog_view": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
        },
        "valid_until": {
          "type": "string",
          "format": "date-time"
        },
        "offers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CapabilityOffer"
          }
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512
        }
      },
      "required": [
        "service_id",
        "catalog_view",
        "revision",
        "valid_until",
        "offers",
        "next_cursor"
      ],
      "additionalProperties": false
    },
    "Availability": {
      "type": "object",
      "properties": {
        "offer_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
        },
        "offer_revision": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
        },
        "state": {
          "type": "string",
          "enum": [
            "available",
            "busy",
            "unavailable",
            "unauthorized",
            "unknown"
          ]
        },
        "checked_at": {
          "type": "string",
          "format": "date-time"
        },
        "valid_until": {
          "type": "string",
          "format": "date-time"
        },
        "retry_after_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600
        }
      },
      "required": [
        "offer_id",
        "offer_revision",
        "revision",
        "state",
        "checked_at",
        "valid_until"
      ],
      "additionalProperties": false
    },
    "ProtocolEndpoint": {
      "type": "object",
      "properties": {
        "version": {
          "const": "lasa/1.0.0"
        },
        "base_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "maxLength": 2048
        },
        "openapi_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "maxLength": 2048
        },
        "features": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "consumer-events",
              "clarification",
              "artifacts"
            ]
          },
          "uniqueItems": true
        },
        "required_features": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "consumer-events",
              "clarification",
              "artifacts"
            ]
          },
          "uniqueItems": true
        },
        "wire_schema_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "version",
        "base_url",
        "openapi_url",
        "features",
        "required_features",
        "wire_schema_digest"
      ],
      "additionalProperties": false
    },
    "ServiceDescriptor": {
      "type": "object",
      "properties": {
        "descriptor_version": {
          "const": "1.0.0"
        },
        "service_id": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "maxLength": 2048
        },
        "deployment_revision": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
        },
        "valid_until": {
          "type": "string",
          "format": "date-time"
        },
        "protocols": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProtocolEndpoint"
          },
          "minItems": 1
        },
        "authentication": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "mode": {
                  "const": "jwt",
                  "default": "jwt"
                },
                "issuer": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https://",
                  "maxLength": 2048
                },
                "audience": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https://",
                  "maxLength": 2048
                }
              },
              "required": [
                "issuer",
                "audience"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "mode": {
                  "const": "static_token"
                }
              },
              "required": [
                "mode"
              ],
              "additionalProperties": false
            }
          ]
        },
        "catalog_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "maxLength": 2048
        },
        "contract_url_template": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "idempotency_retention_seconds": {
          "type": "integer",
          "minimum": 3600,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "descriptor_version",
        "service_id",
        "deployment_revision",
        "revision",
        "valid_until",
        "protocols",
        "authentication",
        "catalog_url",
        "contract_url_template",
        "idempotency_retention_seconds"
      ],
      "additionalProperties": false
    },
    "BootstrapCatalog": {
      "type": "object",
      "properties": {
        "linkset": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "anchor": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://",
                "maxLength": 2048
              },
              "service-desc": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "href": {
                      "type": "string",
                      "format": "uri",
                      "pattern": "^https://",
                      "maxLength": 2048
                    },
                    "type": {
                      "const": "application/json"
                    }
                  },
                  "required": [
                    "href",
                    "type"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1
              },
              "service-meta": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "href": {
                      "type": "string",
                      "format": "uri",
                      "pattern": "^https://",
                      "maxLength": 2048
                    },
                    "type": {
                      "const": "application/json"
                    }
                  },
                  "required": [
                    "href",
                    "type"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1
              }
            },
            "required": [
              "anchor",
              "service-desc",
              "service-meta"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "linkset"
      ],
      "additionalProperties": false
    },
    "OfferSelection": {
      "type": "object",
      "properties": {
        "contract": {
          "$ref": "#/$defs/CapabilityRef"
        },
        "offer_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
        },
        "offer_revision": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
        },
        "catalog_view": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
        }
      },
      "required": [
        "contract",
        "offer_id",
        "offer_revision",
        "catalog_view"
      ],
      "additionalProperties": false
    },
    "TaskRequest": {
      "type": "object",
      "properties": {
        "operation_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
        },
        "selection": {
          "$ref": "#/$defs/OfferSelection"
        },
        "input": {},
        "requested_limits": {
          "$ref": "#/$defs/ConsumerLimits"
        },
        "imports": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvidenceImport"
          },
          "minItems": 1,
          "maxItems": 64
        },
        "attachments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "properties": {
              "manifest": {
                "$ref": "#/$defs/ConsumerArtifact"
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "manifest",
              "text"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "operation_id",
        "selection",
        "input"
      ],
      "additionalProperties": false
    },
    "CreateSession": {
      "type": "object",
      "properties": {
        "operation_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "operation_id"
      ],
      "additionalProperties": false
    },
    "Session": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
        },
        "service_id": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "maxLength": 2048
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "retention_until": {
          "type": "string",
          "format": "date-time"
        },
        "active_task_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
        }
      },
      "required": [
        "session_id",
        "service_id",
        "created_at",
        "retention_until",
        "active_task_id"
      ],
      "additionalProperties": false
    },
    "Question": {
      "type": "object",
      "properties": {
        "question_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "answer_schema": {
          "type": [
            "object",
            "boolean"
          ]
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "question_id",
        "revision",
        "prompt",
        "answer_schema",
        "expires_at"
      ],
      "additionalProperties": false
    },
